{
  "name": "forge",
  "productName": "Forge",
  "version": "0.2.0",
  "description": "AI-powered command center: terminals, Docker home-server management and a Claude agent that can operate both.",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "systeminformation": "^5.33.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.forge.commandcenter",
    "productName": "Forge",
    "copyright": "Forge",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "Forge"
    },
    "nsis": {
      "artifactName": "ForgeInstaller.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Forge",
      "uninstallDisplayName": "Forge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/legoissuperdupercool-maker/-/releases/download/windows-latest"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Forge"
}
